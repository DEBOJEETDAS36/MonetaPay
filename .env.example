# RPC URL for Monad Testnet
MONAD_RPC_URL=https://drpc.org/chainlist/monad-testnet-rpc

# Private key of your deployer wallet (do not use a wallet holding real funds!)
PRIVATE_KEY=your_wallet_private_key_here

# Private key of the off-chain automation relayer/bundler worker (can be the same as above for testing)
RELAYER_PRIVATE_KEY=your_relayer_private_key_here